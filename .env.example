# Copy to .env.local for local development.

# Postgres connection string (Neon, Supabase, Vercel Postgres, …).
# Required in production. Locally, leave unset to save sign-ups to .data/registrations.json.
DATABASE_URL=

# Password for /admin. Admin is disabled until this is set.
ADMIN_PASSWORD=

# Optional: secret for signing admin sessions. Defaults to ADMIN_PASSWORD.
SESSION_SECRET=

# Optional: public URL used in emails and calendar invites.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: headcount cap (registrants + guests). Overrides content/event.ts.
EVENT_CAPACITY=

# Optional: set to "false" to close registration early.
REGISTRATION_OPEN=

# Optional: confirmation emails via Resend (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM="Backyard <hello@your-domain.sg>"
