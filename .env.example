# Copy to .env.local for local development.

# Postgres connection string (Neon, Supabase, Vercel Postgres, …).
# Required in production. Locally, leave unset to save sign-ups to .data/registrations.json.
DATABASE_URL=

# Password for /admin, at least 12 characters. Admin is disabled until it's set.
# Changing it signs every organiser out.
ADMIN_PASSWORD=

# Secret for signing admin sessions (a long random value, e.g. `openssl rand -base64 32`).
# Required in production; locally it falls back to ADMIN_PASSWORD.
SESSION_SECRET=

# Recommended in production: a fixed key (`openssl rand -base64 32`) so form
# submissions from a page opened before a redeploy still work afterwards.
# Without it, Next.js rotates the key every 14 days or on a build without cache.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Optional: public URL used in emails and calendar invites.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: confirmation emails. Set up one of these; Gmail wins if both are set.
# Gmail / Google Workspace: the mailbox you sign in to, plus an app password for it
# (myaccount.google.com/apppasswords; needs 2-Step Verification).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend (https://resend.com):
RESEND_API_KEY=
# Sender shown to guests. With Gmail it can be an alias the mailbox may "send mail as";
# leave it empty to send as GMAIL_USER.
EMAIL_FROM="Backyard SG <hello@your-domain.sg>"
